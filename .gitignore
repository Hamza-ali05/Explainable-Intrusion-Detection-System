# --- Python library environments (installed dependencies) ---
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
wheels/
pip-wheel-metadata/
*.egg
requirements.lock.txt

# --- Python cache / tooling ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
.cursor/
*.swp
*.swo

# --- Secrets (if ever added) ---
.env
.env.*
!.env.example
frontend/.env
*-firebase-adminsdk-*.json
firebase-service-account*.json
*.pem

# --- Node / frontend (dependencies & build output) ---
/package-lock.json
frontend/node_modules/
frontend/dist/
frontend/.vite/

# --- Data / outputs (generated; large or reproducible from pipeline) ---
# Ignore contents but keep folder placeholders via .gitkeep
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/manual/*
!data/manual/.gitkeep
artifacts/*
!artifacts/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
logs/*
!logs/.gitkeep
reports/predictions/*
!reports/predictions/.gitkeep
*.parquet
*.joblib

# --- Regenerated run metadata ---
reports/env.json
reports/timing.json

# --- Large ML tensor dumps ---
*.npy

# --- Pipeline decision / provenance reports (regenerate each run) ---
reports/balance_decisions.md
reports/clean_decisions.md
reports/preprocess_decisions.md
reports/split_report.md
reports/provenance.md
reports/label_mapping.json
reports/model_card.md

# --- EDA outputs (JSON + plots; regenerate via eda step) ---
reports/eda/

# --- XAI figures (regenerate via explain-global / explain-local) ---
# Keep reports/xai/quality/ for dissertation summaries (CSVs, MD, plots)
reports/xai/global/
reports/xai/local/
reports/xai/decision_tree/
reports/xai/random_forest/
reports/xai/xgboost/
reports/xai/local_instance_selection.json

# --- Training / evaluation outputs (regenerate via pipeline / train_plots) ---
reports/train/
reports/evaluate/
