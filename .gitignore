# --- Python library environments (installed dependencies) ---
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
wheels/
pip-wheel-metadata/
*.egg
requirements.lock.txt

# --- Python cache / tooling ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# --- Secrets (if ever added) ---
.env
.env.*
!.env.example

# --- Data / outputs (generated; large or reproducible from pipeline) ---
# Ignore contents but keep folder placeholders via .gitkeep
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/*
!artifacts/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
logs/*
!logs/.gitkeep
reports/predictions/*
!reports/predictions/.gitkeep
*.parquet
*.joblib
