# Python / library dependencies (do not commit installed packages)
.venv/
venv/
env/
ENV/
.env/
*.egg-info/
.eggs/
dist/
build/
wheels/
pip-wheel-metadata/
*.egg
requirements.lock.txt

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data / outputs (generated)
data/raw/
data/interim/
data/processed/
artifacts/
artifacts/models/*.joblib
checkpoints/
logs/
reports/predictions/
*.parquet
*.joblib

# Keep placeholder files so empty dirs exist in git
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!artifacts/.gitkeep
!checkpoints/.gitkeep
!logs/.gitkeep
!reports/.gitkeep
!reports/predictions/.gitkeep
